# SmartFrameSorter-generated output
/output-images/
/output-videos/
*.building/

# Generated release bundles (publish these as GitHub Release assets)
/release/*-windows-x64/
/release/*-windows-x64.zip
/release/sources/*-source.zip
/release/SHA256SUMS

# Go build and test artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov
cpu.prof
mem.prof

# Ignore incidental Windows executables, but retain the offline binaries that
# are part of this repository and are verified by release_test.go.
*.exe
!/smart-frame-sorter.exe
!/ffmpeg/ffmpeg.exe
!/ffmpeg/ffprobe.exe

# Local Go workspace checksum file
go.work.sum

# Local configuration and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
